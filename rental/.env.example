PORT=8080

POSTGRES_DB=rental
POSTGRES_PORT=5432
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=

# Google OAuth2 credentials จาก https://console.cloud.google.com/apis/credentials
# Authorized redirect URI ต้องตั้งเป็น: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=http://localhost:5173

# อีเมลที่ให้สิทธิ์ ADMIN / STAFF โดยอัตโนมัติตอน login ครั้งแรก (คั่นด้วย comma, ไม่เว้นวรรค)
ADMIN_EMAILS=owner@example.com
STAFF_EMAILS=staff1@example.com,staff2@example.com
