# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้แล้ว ห้าม commit ค่าจริง)

# Google OAuth2 credentials จาก https://console.cloud.google.com/apis/credentials
# Authorized redirect URI ต้องตั้งเป็น: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL ของ frontend (ใช้ทำ CORS + redirect หลัง login/logout)
# pnpm dev = http://localhost:5173 / frontend ใน Docker = http://localhost:3000
FRONTEND_URL=http://localhost:5173
# port ของ container frontend (nginx) บนเครื่อง
FRONTEND_PORT=3000

# อีเมลที่ให้สิทธิ์ ADMIN / STAFF โดยอัตโนมัติตอน login ครั้งแรก (คั่นด้วย comma, ไม่เว้นวรรค)
ADMIN_EMAILS=owner@example.com
STAFF_EMAILS=staff1@example.com,staff2@example.com

# Gemini API key สำหรับ ChatAI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
