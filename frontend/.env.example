# ใช้ตอนรัน `pnpm dev` (dev server เรียก backend ตรง ๆ คนละ origin)
# ตอน build ผ่าน docker (docker-compose.yml) ค่านี้ไม่ถูกใช้ - ดู Dockerfile (ARG VITE_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:8080

# ใช้โดย docker-compose.yml 
# พอร์ตบนเครื่อง host ที่จะ map เข้า container 6000
NGINX_PORT=6000
# origin ของ backend ที่ nginx จะ proxy /api, /oauth2, /login ไปหา
NGINX_PROXY=http://g10-pj-backend:8080
